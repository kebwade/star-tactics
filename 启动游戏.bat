@echo off
chcp 936 >nul
cd /d "%~dp0"
echo.
echo   科币战争 —— 巴巴博弈
echo   ==========================================
echo   正在用默认浏览器打开 index.html ...
echo.
echo   开始界面上的三个入口：
echo     - 人机模式   24 关闯关，通关后进入无尽模式
echo     - 对战模式   暂未开放（点了会提示）
echo     - 设置       总音量 / 音效 / 背景音乐 / 画面亮度
echo.
echo   布阵与战斗（两者的尺子完全一样）：
echo     - 布阵盘 8 列 x 4 行，战场 8 列 x 8 行 = 布阵盘的两倍
echo     - 格子大小和间距两边共用同一套，所以布阵怎么摆、打起来就在哪
echo     - 我方半场 = 布阵盘整块下移，列位置逐列重合（实测偏差 0px）
echo     - 战场关于中线对称，双方各占一半
echo.
echo   24 关 + 无尽模式：
echo     - 第 1~10 关  教学到中段高墙（第 9/10 关是第一个坎）
echo     - 第 11~24 关 四费五费成规模，满编 8 人
echo     - 第 24 关后  无尽模式：随机出怪，每波敌人面板复利 +7%
echo.
echo   界面布局：
echo     - 商店在最上面，备战池在最下面，自己阵容在正中间
echo     - 左栏：对手情报 / 选中与羁绊 / 装备栏
echo     - 右栏：回合记录 / 开战按钮
echo     - 战斗中：战场独占中间，左边是对阵+播放，右边是战报
echo     - 所有尺寸由屏幕算出来，窗口随便拉都不会压住邻居
echo.
echo   常用操作：
echo     - 点空格子选中，再点商店卡片买入、点备战池棋子放上去
echo     - 点棋盘上的棋子改星级/装备，右键可以卖掉
echo     - 战斗中：空格暂停，播放条可以 0.5x~4x 变速
echo.
echo   棋子立绘：双击 tools\做个立绘.bat（选图 + 填 id，自动转好放进 art\）
echo   开发用（改数值/看战斗日志）：console.html
echo   跑自检：双击 跑自检.bat
echo.
start "" "%~dp0index.html"
timeout /t 4 >nul